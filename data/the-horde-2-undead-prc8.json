10,"Int":10,"Wis":10,"Cha":3},"Classes":[{"Class":"Undead","Level":2},{"Class":"Fighter","Level":3}],"Portrait":"Zo_War02_","Tag":"ms_spawnzombie"}],"items":[{"ResRef":"armhe011","Name":"Golden Circlet","Description":"Creatures that attack the mind are the stuff of nightmares, so it is not surprising that items protecting against them might acquire some of their disrepute. Golden Circlets, for example, have been linked to a claim that when the drow first retreated underground they fed on inte…","BaseItem":"Helmet","BaseItemId":17,"GoldPieceValue":15252,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":4,"Tag":"NW_ARMHE010","PropertiesDecoded":["Mind-Affecting Spells Immunity: Miscellaneous","Will Saving Throw Bonus: Specific +1","Concentration Skill Bonus +1","Spell Resistance 10"]},{"ResRef":"dragonblade","Name":"Dragon's Bane","Description":"These swords, the bane of evil dragons, are sometimes given in return for valiant deeds performed towards good dragonkind.  Although the wielder of such a blade is considered a friend by good dragons, its misuse is likely to draw their wrath.","BaseItem":"Longsword","BaseItemId":1,"GoldPieceValue":28834,"StackSize":1,"Charges":0,"Plot":true,"Identified":false,"Stolen":true,"Cursed":false,"PropertiesCount":5,"Tag":"HD2_DragonBlade","PropertiesDecoded":["Evil Attack Bonus vs. Alignment Group +4","Dragon Attack Bonus vs. Racial Group +5","Keen","Light Bright (20m)","Good Use Limitation: Alignment Group"]},{"ResRef":"it_creitem002","Name":"Adult Silver Dragon Properties","Description":"","BaseItem":"Creature Item","BaseItemId":73,"GoldPieceValue":0,"StackSize":1,"Charges":0,"Plot":false,"Identified":false,"Stolen":false,"Cursed":false,"PropertiesCount":8,"Tag":"NW_IT_CREITEMDRP","PropertiesDecoded":["+1 Damage Reduction Soak 5 Damage","Acid Immunity: Damage Type 1","Cold Immunity: Damage Type 1","Mind-Affecting Spells Immunity: Miscellaneous","Paralysis Immunity: Miscellaneous","Sneak Attack Immunity: Miscellaneous","Spell Resistance 22","True Seeing"]},{"ResRef":"it_msmlmisc018","Name":"Dragon Blood","Description":"This is the blood of a dragon.","BaseItem":"Miscellaneous Thin","BaseItemId":79,"GoldPieceValue":9,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"NW_IT_MSMLMISC17"},{"ResRef":"it_torch002","Name":"Torch (Red)","Description":"The additoin of certain chemicals to the tallow results in the altered colour of light that this torch emits.","BaseItem":"Torch","BaseItemId":15,"GoldPieceValue":7,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_IT_TORCH001","PropertiesDecoded":["Light Bright (20m)"]},{"ResRef":"it_torch003","Name":"Torch (Purple)","Description":"The additoin of certain chemicals to the tallow results in the altered colour of light that this torch emits.","BaseItem":"Torch","BaseItemId":15,"GoldPieceValue":7,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_IT_TORCH001","PropertiesDecoded":["Light Bright (20m)"]},{"ResRef":"it_torch004","Name":"Torch (Blue)","Description":"The additoin of certain chemicals to the tallow results in the altered colour of light that this torch emits.","BaseItem":"Torch","BaseItemId":15,"GoldPieceValue":7,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_IT_TORCH001","PropertiesDecoded":["Light Bright (20m)"]},{"ResRef":"it_torch005","Name":"Torch (White)","Description":"The additoin of certain chemicals to the tallow results in the altered colour of light that this torch emits.","BaseItem":"Torch","BaseItemId":15,"GoldPieceValue":7,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_IT_TORCH001","PropertiesDecoded":["Light Bright (20m)"]},{"ResRef":"it_torch006","Name":"Torch (Orange)","Description":"The additoin of certain chemicals to the tallow results in the altered colour of light that this torch emits.","BaseItem":"Torch","BaseItemId":15,"GoldPieceValue":7,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_IT_TORCH001","PropertiesDecoded":["Light Bright (20m)"]},{"ResRef":"it_torch007","Name":"Torch (Green)","Description":"The additoin of certain chemicals to the tallow results in the altered colour of light that this torch emits.","BaseItem":"Torch","BaseItemId":15,"GoldPieceValue":7,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_IT_TORCH001","PropertiesDecoded":["Light Bright (20m)"]},{"ResRef":"journal","Name":"Journal","Description":"I tire of these \"allies\".  First they ask for the lower caverns, then they ask for Rauvin Pass to be cleared of dwarves.  This goes too far...\n\nIf it ever gets here I shall keep the altar for myself and send these fools to the afterlife.","BaseItem":"Book","BaseItemId":74,"GoldPieceValue":1,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"HD2_Journal"},{"ResRef":"journal001","Name":"Cult Leader's Journal","Description":"Highsun Day 6:\nThe results from the experiments with the orcs and dragon's blood are better than we could have hoped.\n\nHighsun Day 14:\nI am concerned about the Holding Pillar.  The runes of silver laced adamantine are fading fast.  Without this to keep our pet captive we have no…","BaseItem":"Book","BaseItemId":74,"GoldPieceValue":1,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"HD2_Journal"},{"ResRef":"laboratorynotes","Name":"Laboratory Notes","Description":"You come across a rather disturbing excerpt among the laboratory notes:\n\nThe use of Dragon's blood in the transformation of the orcs is extremely efficient.  None of the side effects that were observed with our previous experiments have occurred and nearly all of the subjects ha…","BaseItem":"Book","BaseItemId":74,"GoldPieceValue":1,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"HD2_LaboratoryNotes"},{"ResRef":"maarcl081","Name":"Full Plate +3","Description":"This magic armor grants additional protection to its wearer, but it doesn't bear the hallmarks of any specific maker.","BaseItem":"Armor","BaseItemId":16,"GoldPieceValue":1500,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"NW_MAARCL080"},{"ResRef":"merchantcloth001","Name":"Merchant Clothing","Description":"","BaseItem":"Armor","BaseItemId":16,"GoldPieceValue":1,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"MerchantClothing"},{"ResRef":"merchantcloth002","Name":"Merchant Clothing","Description":"","BaseItem":"Armor","BaseItemId":16,"GoldPieceValue":1,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"MerchantClothing"},{"ResRef":"merchantclothing","Name":"Merchant Clothing","Description":"","BaseItem":"Armor","BaseItemId":16,"GoldPieceValue":1,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":0,"Tag":"MerchantClothing"},{"ResRef":"wdbmqs009","Name":"Quarterstaff +2","Description":"This magic weapon has an enhancement bonus to attack and damage, but it doesn't bear the hallmarks of any specific maker.","BaseItem":"Quarterstaff","BaseItemId":50,"GoldPieceValue":7220,"StackSize":1,"Charges":0,"Plot":false,"Identified":true,"Stolen":false,"Cursed":false,"PropertiesCount":1,"Tag":"NW_WDBMQS008","PropertiesDecoded":["Enhancement Bonus +2"]}]}